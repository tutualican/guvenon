<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GuvenOn.App</RootNamespace>
    <AssemblyName>guvenon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\guvenon.ico</ApplicationIcon>
    <!-- WPF owns DPI awareness through the manifest; the WinForms tray host does not. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Guven-ON.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuvenOn.Core\GuvenOn.Core.csproj" />
  </ItemGroup>

</Project>
