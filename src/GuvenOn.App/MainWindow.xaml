<Window x:Class="GuvenOn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GuvenOn.App.Localization"
        Title="{Binding [AppName], Source={x:Static loc:Loc.Instance}}"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" Margin="40,32,40,40">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/Guven-ON.png"
                               Width="38"
                               Height="38"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [AppName], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource H1}" />
                        <Border Background="{StaticResource PreviewBadgeBrush}"
                                CornerRadius="6"
                                Padding="8,3"
                                Margin="12,7,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Preview], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PreviewBadgeTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding [AppTagline], Source={x:Static loc:Loc.Instance}}"
                               Style="{StaticResource Subtitle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot"
                             Width="12"
                             Height="12"
                             Fill="{StaticResource StatusAmberBrush}"
                             VerticalAlignment="Top"
                             Margin="0,7,16,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle"
                                   Style="{StaticResource H2}"
                                   Text="{Binding [StatusServiceMissing], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock x:Name="StatusDetail"
                                   Style="{StaticResource BodyMuted}"
                                   Margin="0,4,0,0"
                                   Text="{Binding [StatusServiceMissingDetail], Source={x:Static loc:Loc.Instance}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{Binding [Refresh], Source={x:Static loc:Loc.Instance}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="Refresh_Click" />
                            <TextBlock x:Name="ServiceLine"
                                       Style="{StaticResource Caption}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Protection -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="ProtectionDot"
                             Width="12"
                             Height="12"
                             Fill="{StaticResource StatusAmberBrush}"
                             VerticalAlignment="Top"
                             Margin="0,7,16,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [Protection], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource H2}" />
                        <TextBlock x:Name="ProtectionStateText"
                                   Style="{StaticResource BodyStrong}"
                                   Margin="0,6,0,0" />
                        <TextBlock x:Name="ProtectionDetailText"
                                   Style="{StaticResource BodyMuted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ProtectionButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="Protection_Click" />
                            <Button x:Name="PauseButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="Pause_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Advanced protection -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding [AdvancedProtection], Source={x:Static loc:Loc.Instance}}"
                               Style="{StaticResource H2}" />

                    <Grid Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource StatusGreenBrush}"
                                 VerticalAlignment="Top"
                                 Margin="2,7,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [AdvancedDnsTitle], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding [AdvancedDnsBody], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource StatusGreenBrush}"
                                 VerticalAlignment="Top"
                                 Margin="2,7,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [AdvancedLanTitle], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding [AdvancedLanBody], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource StatusGreenBrush}"
                                 VerticalAlignment="Top"
                                 Margin="2,7,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [AdvancedPersistentTitle], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding [AdvancedPersistentBody], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,16,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding [AdvancedSelfTestHint], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelfTestResult"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <Button x:Name="SelfTestButton"
                                Grid.Column="1"
                                Content="{Binding [AdvancedSelfTest], Source={x:Static loc:Loc.Instance}}"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                VerticalAlignment="Center"
                                Click="SelfTest_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding [Network], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource Label}" />
                        <TextBlock x:Name="NetworkName"
                                   Style="{StaticResource BodyStrong}"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="NetworkType"
                                   Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [SoftwareUpdates], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource H2}" />
                        <TextBlock x:Name="UpdateStatus"
                                   Style="{StaticResource BodyMuted}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DownloadButton"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="Download_Click" />
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource SecondaryButton}"
                                Click="Update_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings], Source={x:Static loc:Loc.Instance}}"
                               Style="{StaticResource H2}"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding [LanguageHint], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox"
                                  Grid.Column="1"
                                  Width="170"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="LanguageBox_SelectionChanged" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,2,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding [StartWithWindows], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding [StartWithWindowsHint], Source={x:Static loc:Loc.Instance}}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="AutostartBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="Autostart_Changed"
                                  Unchecked="Autostart_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid Margin="4,8,4,0">
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [Exit], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource LinkButton}"
                            Margin="0,0,18,0"
                            Click="Exit_Click" />
                    <Button Content="{Binding [HideToTray], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource LinkButton}"
                            Click="Hide_Click" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
